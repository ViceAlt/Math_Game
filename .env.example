# ============================================================
# Math Game - Arquivo de Configuração de Ambiente (.env)
# ============================================================
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente.
# NUNCA envie o arquivo .env com credenciais reais para o Git!

# ── 1. Aplicação ─────────────────────────────────────────────
APP_ENV=development
# URL base do site (sem barra no final). Se vazio, é detectado automaticamente.
APP_URL=http://localhost/Math_Game

# ── 2. Banco de Dados MySQL ───────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=math_game
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

