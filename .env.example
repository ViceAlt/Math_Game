# ============================================================
# Math Game - Arquivo de Configuração de Ambiente (.env)
# ============================================================
# Use como referência para o arquivo privado D:\Xampp\private\Math_Game\.env.
# Nunca armazene credenciais reais em htdocs nem envie .env ao Git.

# ── 1. Aplicação ─────────────────────────────────────────────
APP_ENV=development
# Em produção, defina a URL canônica HTTPS do site, sem barra final.
APP_URL=http://localhost/GitHub/Math_Game

# ── 2. Banco de Dados MySQL ───────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=math_game
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Chave de 32 bytes em hexadecimal (64 caracteres); não altere após criar segredos.
# Gere com: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
RECOVERY_SECRET_KEY=gere_uma_chave_de_64_caracteres_hexadecimais

# ── 3. Expiração de Token de Recuperação de Senha ────────────
# Validade em minutos (padrão: 60 minutos / 1 hora)
TOKEN_EXPIRACAO_MINUTOS=60

# ── 4. Depuração de Envio de E-mail (Logs Temporários) ───────
# Quando 'true', grava o handshake completo do SMTP em logs/recuperacao.log
# Desative (false) em produção para economizar espaço e evitar logs excessivos.
SMTP_DEBUG=false

# ── 5. Configuração de Servidor de E-mail (SMTP) ─────────────
# Escolha UMA das opções abaixo e configure:

# ── OPÇÃO A: Mailpit Local (Ambiente de desenvolvimento com Laragon)
# Mailpit captura todos os e-mails na sua máquina para você testar sem enviar de verdade.
# Abra no navegador: http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_FROM_EMAIL=nao-responda@mathgame.local
SMTP_FROM_NAME="Math Game"

# ── OPÇÃO B: Mailtrap (Sandbox para testes online)
# Crie conta grátis em mailtrap.io e pegue as credenciais no Inbox.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_AUTH=true
# SMTP_USER=seu_usuario_mailtrap
# SMTP_PASS=sua_senha_mailtrap
# SMTP_SECURE=tls
# SMTP_FROM_EMAIL=nao-responda@mathgame.test
# SMTP_FROM_NAME="Math Game"

# ── OPÇÃO C: Gmail (Envio real com Senha de App)
# ATENÇÃO: Requer autenticação de 2 fatores ativada na sua Conta Google.
# Crie uma "Senha de App" em: https://myaccount.google.com/apppasswords
# Não use a senha comum do seu e-mail!
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_AUTH=true
# SMTP_USER=seu_email@gmail.com
# SMTP_PASS=sua_senha_de_app_16_digitos
# SMTP_SECURE=tls
# SMTP_FROM_EMAIL=seu_email@gmail.com
# SMTP_FROM_NAME="Math Game"

# ── OPÇÃO D: Domínio Próprio / Hospedagem (cPanel, Hostinger, Locaweb, etc.)
# SMTP_HOST=mail.seudominio.com.br
# SMTP_PORT=465
# SMTP_AUTH=true
# SMTP_USER=contato@seudominio.com.br
# SMTP_PASS=sua_senha_do_webmail
# SMTP_SECURE=ssl
# SMTP_FROM_EMAIL=contato@seudominio.com.br
# SMTP_FROM_NAME="Math Game"
