Options -Indexes -MultiViews

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'"
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "(?i)(?:^\.|\.(?:env|ini|log|sql|bak|old|orig|dist|conf|ya?ml|lock)$|^(?:composer\.(?:json|lock)|Cavaleiro\.af|config\.php|conexao\.php|test_(?:api|email)\.php|scratch_.*\.php)$)">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)(?:^\.|\.(?:env|ini|log|sql|bak|old|orig|dist|conf|ya?ml|lock)$|^(?:composer\.(?:json|lock)|Cavaleiro\.af|config\.php|conexao\.php|test_(?:api|email)\.php|scratch_.*\.php)$)">
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_alias.c>
    RedirectMatch 404 "(?i)(?:^|/)(?:\.git|\.github|\.agent|vendor|migrations|sql|logs)(?:/|$)"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:\.git|\.github|\.agent|vendor|migrations|sql|logs)(?:/|$) - [F,L,NC]
    RewriteRule ^includes/.*\.php$ - [F,L,NC]
</IfModule>